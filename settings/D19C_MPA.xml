               <CIC2 enableBend="1" enableLastLine="1" enableSparsification="0" clockFrequency="320"/>
            </Global>

            <SSA_Files path="./settings/SSAFiles/" />
            <SSA Id="0" partid="0" configfile="SSAPreCalib.txt" />
