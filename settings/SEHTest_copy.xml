<Monitoring type="2SSEH" enable="1">
    <MonitoringSleepTime> 1000 </MonitoringSleepTime>
    
    <MonitoringElement device="Board" register="I_SEH" enable="1"/>
</Monitoring>
</MonitoringSettings> -->


</HwDescription>
